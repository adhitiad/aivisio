# ==============================================
# AIVISO — TanStack Start + BetterAuth + Prisma
# Salin ke .env lalu sesuaikan.
# ==============================================

# PostgreSQL (Prisma)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aiviso

# URL publik situs (sitemap, canonical, OAuth redirect, trusted origin)
SITE_URL=http://localhost:3000

# ==============================================
# AUTH — login TANPA kata sandi: Google & Facebook/Meta saja.
# Redirect URI:
#   Google:   ${SITE_URL}/api/auth/callback/google
#   Facebook: ${SITE_URL}/api/auth/callback/facebook
# ==============================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# BetterAuth — wajib produksi. Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Legacy only: authorization now requires OWNER/ADMIN roles; this variable is ignored.
ADMIN_API_GATE=

# ==============================================
# SECURITY — owner bootstrap and provider secrets
# ==============================================
# Comma-separated, verified OAuth emails bootstrapped as OWNER.
OWNER_EMAILS=
# Set a random 32+ character secret; if omitted, BETTER_AUTH_SECRET is used.
# Existing provider keys can be encrypted with: bun run security:encrypt-provider-keys
PROVIDER_ENCRYPTION_KEY=

# ==============================================
# YOUTUBE DATA API — public market discovery
# ==============================================
# Server-side API key. Restrict it to YouTube Data API v3 and trusted server IPs.
YOUTUBE_DATA_API_KEY=

# Bearer secret for /api/youtube/scheduler. Generate with: openssl rand -hex 32
YOUTUBE_CRON_SECRET=

# Durable PostgreSQL-backed video worker
VIDEO_WORKER_POLL_MS=2500
VIDEO_WORKER_LEASE_MS=180000
VIDEO_WORKER_MAX_ATTEMPTS=4
