# ==============================================
# AIVISO — TanStack Start + BetterAuth + Prisma
# Salin ke .env lalu sesuaikan.
# ==============================================

# PostgreSQL (Prisma)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aiviso

# URL publik situs (sitemap, canonical, OAuth redirect, trusted origin)
SITE_URL=http://localhost:3000

# ==============================================
# AUTH — login TANPA kata sandi: Google & Facebook/Meta saja.
# Redirect URI:
#   Google:   ${SITE_URL}/api/auth/callback/google
#   Facebook: ${SITE_URL}/api/auth/callback/facebook
# ==============================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# BetterAuth — wajib produksi. Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Proteksi endpoint mutasi. Kosong = terbuka (mode single-user).
# Set "1" untuk mewajibkan login OAuth.
ADMIN_API_GATE=
