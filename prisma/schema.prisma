// AIVISO — Prisma schema (PostgreSQL + UUIDv7)
// Aturan repo: semua model punya createdAt/updatedAt; kolom filter/sort diberi index.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// BetterAuth — user / session / account / verification
// ---------------------------------------------------------------------------

model User {
  id            String         @id @default(uuid(7))
  name          String
  email         String         @unique
  emailVerified Boolean        @default(false)
  role          String         @default("CREATOR")
  image         String?
  provider      String? // legacy: penyedia OAuth pertama kali (google | facebook)
  sessions      Session[]
  accounts      Account[]
  generations   Generation[]
  videoProjects VideoProject[]
  footageAssets FootageAsset[]
  thumbnailVariants ThumbnailVariant[]
  mediaAssets   MediaAsset[]
  youtubeChannels YoutubeChannel[]
  youtubeOAuthConnection YoutubeOAuthConnection?
  youtubeOAuthStates YoutubeOAuthState[]
  trackedMarketTopics YoutubeTrackedMarketTopic[]
  notifications Notification[]
  notificationReadReceipts NotificationReadReceipt[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([email])
  @@index([role])
  @@index([createdAt])
}

model Session {
  id        String   @id @default(uuid(7))
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
}

model Account {
  id                    String    @id @default(uuid(7))
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  youtubeChannels       YoutubeChannel[]
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@index([providerId, accountId])
}

model Verification {
  id         String   @id @default(uuid(7))
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Model aplikasi
// ---------------------------------------------------------------------------

model Generation {
  id        String   @id @default(uuid(7))
  userId    String?
  toolId    String
  title     String
  inputs    String
  output    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([toolId])
  @@index([createdAt])
}

model VideoProject {
  id              String   @id @default(uuid(7))
  userId          String?
  contentIdeaId   String?
  strategyContext String   @default("")
  topic           String
  format          String // "short" | "long"
  style           String
  renderMode      String // "cinematic" | "fast"
  voice           String // nama voice TTS atau "off"
  aspect          String   @default("9:16") // 1:1 | 9:16 | 4:3 | 16:9
  researchEnabled Boolean  @default(false)
  research        String   @default("[]")
  targetScenes    Int      @default(0)
  title           String?
  description     String?
  status          String   @default("queued") // queued|planning|building|stitching|done|error
  stageDetail     String?
  progress        Int      @default(0)
  scenesTotal     Int      @default(0)
  scenesDone      Int      @default(0)
  durationSec     Int      @default(0)
  filePath        String? // legacy path; cleared after successful object-storage upload
  fileObjectKey   String?
  fileBytes       Int      @default(0)
  scenes          String   @default("[]")
  videoJob        VideoJob?
  thumbnailVariants ThumbnailVariant[]
  mediaAssets     MediaAsset[]
  error           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  contentIdea     ContentIdea? @relation(fields: [contentIdeaId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([contentIdeaId, createdAt])
  @@index([status])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// YouTube Growth Studio — private channel data and user-consented OAuth tokens.
// YouTube OAuth is intentionally separate from BetterAuth sign-in accounts.
// ---------------------------------------------------------------------------

model YoutubeChannel {
  id                String                  @id @default(uuid(7))
  userId            String
  accountId         String?
  oauthConnectionId String?
  youtubeChannelId  String                  @unique
  title             String
  handle            String?
  thumbnailUrl      String?
  description       String?
  country           String?
  audience          String?
  primaryLanguage   String?
  formats           String                  @default("[]")
  focusMarkets      String                  @default("[]")
  weeklyHours       Int?
  teamSize          String?
  monthlyBudget     Int?
  connectionStatus  String                  @default("connected") // connected | needs_reconnect | disconnected
  lastSyncedAt      DateTime?
  lastAnalyticsSyncedAt DateTime?
  analyticsSyncError String?
  user              User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  account           Account?                @relation(fields: [accountId], references: [id], onDelete: SetNull)
  oauthConnection   YoutubeOAuthConnection? @relation(fields: [oauthConnectionId], references: [id], onDelete: SetNull)
  analyticsDailyMetrics YoutubeAnalyticsDailyMetric[]
  goal              YoutubeGoal?
  metricSnapshots   YoutubeMetricSnapshot[]
  trendSignals      YoutubeTrendSignal[]
  contentIdeas      ContentIdea[]
  nicheProfile      YoutubeNicheProfile?
  strategySnapshots YoutubeContentStrategySnapshot[]
  videoPerformanceSnapshots YoutubeVideoPerformanceSnapshot[]
  countryPerformanceSnapshots YoutubeCountryPerformanceSnapshot[]
  revenueForecasts  YoutubeRevenueForecast[]
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  @@index([userId, createdAt])
  @@index([accountId])
  @@index([oauthConnectionId])
  @@index([connectionStatus])
  @@index([lastAnalyticsSyncedAt])
}

model YoutubeGoal {
  id                String         @id @default(uuid(7))
  channelId         String         @unique
  targetSubscribers Int            @default(2500)
  targetViews       BigInt         @default(800000)
  targetDays        Int            @default(60)
  startedAt         DateTime       @default(now())
  channel           YoutubeChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([startedAt])
}

model YoutubeMetricSnapshot {
  id                String         @id @default(uuid(7))
  channelId         String
  capturedOn        DateTime
  subscriberCount   Int            @default(0)
  totalViews        BigInt         @default(0)
  publicVideoCount  Int            @default(0)
  source            String         @default("youtube-data-api")
  channel           YoutubeChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@unique([channelId, capturedOn])
  @@index([channelId, capturedOn])
}

model YoutubeTrendSignal {
  id                String         @id @default(uuid(7))
  channelId         String
  market            String
  topic             String
  videoId           String?
  videoUrl          String?
  format            String?
  publishedAt       DateTime?
  viewCount         BigInt         @default(0)
  likeCount         BigInt         @default(0)
  momentumScore     Int            @default(0)
  confidence        String         @default("regional-public") // regional-public | channel-analytics
  source            String         @default("youtube-data-api")
  capturedAt        DateTime       @default(now())
  channel           YoutubeChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([channelId, capturedAt])
  @@index([market, momentumScore])
  @@index([videoId])
}

model ContentIdea {
  id                String         @id @default(uuid(7))
  channelId         String
  title             String
  angle             String?
  format            String         @default("long") // short | long
  status            String         @default("backlog") // backlog | researching | scripting | producing | produced | production_failed | published | archived
  plannedFor        DateTime?
  evidence          String         @default("[]")
  channel           YoutubeChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  strategySnapshots YoutubeContentStrategySnapshot[]
  videoProjects     VideoProject[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([channelId, status])
  @@index([channelId, plannedFor])
  @@index([createdAt])
}

model AiProvider {
  id            String    @id @default(uuid(7))
  key           String    @unique
  label         String
  baseUrl       String    @default("")
  apiKey        String    @default("")
  model         String    @default("")
  enabled       Boolean   @default(false)
  active        Boolean   @default(false)
  status        String    @default("unknown") // unknown | ok | error
  statusMessage String?
  lastCheckedAt DateTime?
  note          String?
  sortOrder     Int       @default(100)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([enabled])
  @@index([sortOrder])
}

model Notification {
  id        String   @id @default(uuid(7))
  userId    String? // null = broadcast ke semua user
  title     String
  body      String?
  type      String   @default("info") // info | success | warning | error
  read      Boolean  @default(false)
  link      String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  readReceipts NotificationReadReceipt[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([read])
  @@index([createdAt])
}

model Setting {
  id        String   @id @default(uuid(7))
  key       String   @unique
  value     String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([key])
}

model ContactMessage {
  id        String   @id @default(uuid(7))
  name      String
  email     String
  subject   String?
  message   String
  status    String   @default("new") // new | read | archived
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}


// Per-user read and dismissal state for global broadcast notifications.
model NotificationReadReceipt {
  id             String       @id @default(uuid(7))
  notificationId String
  userId         String
  read           Boolean      @default(false)
  dismissed      Boolean      @default(false)
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([notificationId, userId])
  @@index([userId, createdAt])
  @@index([notificationId])
}


model YoutubeMarketQuery {
  id           String              @id @default(uuid(7))
  cacheKey     String              @unique
  query        String
  market       String
  languageCode String
  order        String
  periodDays   Int
  resultCount  Int                 @default(0)
  source       String              @default("youtube-data-api-v3")
  observedAt   DateTime            @default(now())
  expiresAt    DateTime
  videos       YoutubeMarketVideo[]
  observations YoutubeMarketVideoObservation[]
  trackedTopics YoutubeTrackedMarketTopic[]
  opportunityScores YoutubeOpportunityScoreSnapshot[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([market, observedAt])
  @@index([expiresAt])
}

model YoutubeMarketVideo {
  id              String             @id @default(uuid(7))
  queryId         String
  videoId         String
  channelId       String
  channelTitle    String
  title           String
  description     String?
  publishedAt     DateTime?
  durationSec     Int?
  viewCount       BigInt             @default(0)
  likeCount       BigInt             @default(0)
  commentCount    BigInt             @default(0)
  subscriberCount BigInt?
  viewsPerDay     Float              @default(0)
  engagementRate  Float              @default(0)
  velocityIndex   Float              @default(0)
  momentumViewsPerDay Float?
  momentumGrowthPct Float?
  momentumSampleHours Float?
  opportunityScore Float?
  scoringConfidence String?
  scoringComponents String @default("{}")
  opportunityRationale String @default("[]")
  momentumObservationCount Int @default(0)
  thumbnailUrl    String?
  videoUrl        String
  query           YoutubeMarketQuery @relation(fields: [queryId], references: [id], onDelete: Cascade)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@unique([queryId, videoId])
  @@index([queryId, velocityIndex])
  @@index([videoId])
  @@index([channelId])
}

model YoutubeApiUsage {
  id           String   @id @default(uuid(7))
  quotaDate    String   @unique
  searchCalls  Int      @default(0)
  dataApiUnits Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([quotaDate])
}


// Separate Google OAuth connection for private YouTube Data and Analytics scopes.
model YoutubeOAuthConnection {
  id                    String          @id @default(uuid(7))
  userId                String          @unique
  googleSubject         String?
  googleEmail           String?
  accessTokenEncrypted String
  refreshTokenEncrypted String?
  tokenExpiresAt        DateTime?
  scopes                String          @default("")
  connectionStatus      String          @default("connected") // connected | needs_reconnect
  lastVerifiedAt        DateTime?
  user                  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  channels              YoutubeChannel[]
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  @@index([connectionStatus])
  @@index([googleSubject])
  @@index([createdAt])
}

// One-time, user-bound OAuth state and PKCE verifier. Raw state is never stored.
model YoutubeOAuthState {
  id                    String   @id @default(uuid(7))
  stateHash             String   @unique
  userId                String
  codeVerifierEncrypted String
  expiresAt             DateTime
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

// Daily private metrics fetched from YouTube Analytics API v2.
model YoutubeAnalyticsDailyMetric {
  id                      String         @id @default(uuid(7))
  channelId               String
  metricDate              DateTime
  views                   BigInt         @default(0)
  estimatedMinutesWatched Float          @default(0)
  averageViewDuration     Float          @default(0)
  averageViewPercentage   Float          @default(0)
  likes                   BigInt         @default(0)
  comments                BigInt         @default(0)
  shares                  BigInt         @default(0)
  subscribersGained       Int            @default(0)
  subscribersLost         Int            @default(0)
  estimatedRevenue        Float?
  estimatedAdRevenue      Float?
  currencyCode            String         @default("IDR")
  channel                 YoutubeChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt

  @@unique([channelId, metricDate])
  @@index([channelId, metricDate])
  @@index([metricDate])
}


// Creator-owned public market queries to monitor on a recurring schedule.
model YoutubeTrackedMarketTopic {
  id            String              @id @default(uuid(7))
  userId        String
  queryId       String?
  query         String
  market        String
  order         String              @default("relevance")
  periodDays    Int                 @default(90)
  maxResults    Int                 @default(50)
  active        Boolean             @default(true)
  lastSnapshotAt DateTime?
  nextRunAt     DateTime            @default(now())
  lastError     String?
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  marketQuery   YoutubeMarketQuery? @relation(fields: [queryId], references: [id], onDelete: SetNull)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@unique([userId, query, market])
  @@index([userId, active])
  @@index([active, nextRunAt])
  @@index([queryId])
}

// Immutable public-stat observations. Never overwrite earlier measurements.
model YoutubeMarketVideoObservation {
  id              String             @id @default(uuid(7))
  queryId         String
  videoId         String
  channelId       String
  channelTitle    String
  title           String
  publishedAt     DateTime?
  viewCount       BigInt             @default(0)
  likeCount       BigInt             @default(0)
  commentCount    BigInt             @default(0)
  subscriberCount BigInt?
  viewsPerDay     Float              @default(0)
  engagementRate  Float              @default(0)
  velocityIndex   Float              @default(0)
  capturedAt      DateTime           @default(now())
  query           YoutubeMarketQuery @relation(fields: [queryId], references: [id], onDelete: Cascade)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@unique([queryId, videoId, capturedAt])
  @@index([queryId, capturedAt])
  @@index([videoId, capturedAt])
  @@index([channelId, capturedAt])
}

// Versioned, explainable opportunity scoring snapshots for public market videos.
model YoutubeOpportunityScoreSnapshot {
  id              String             @id @default(uuid(7))
  queryId         String
  videoId         String
  score           Float
  confidence      String             @default("limited") // high | medium | limited
  algorithmVersion String            @default("v1")
  momentumScore   Float
  demandScore     Float
  engagementScore Float
  competitionScore Float
  freshnessScore Float
  components      String              @default("{}")
  rationale       String              @default("[]")
  capturedAt      DateTime            @default(now())
  query           YoutubeMarketQuery  @relation(fields: [queryId], references: [id], onDelete: Cascade)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@unique([queryId, videoId, capturedAt])
  @@index([queryId, score])
  @@index([videoId, capturedAt])
  @@index([capturedAt])
}


model VideoJob {
  id             String       @id @default(uuid(7))
  videoProjectId String       @unique
  status         String       @default("queued") // queued | processing | completed | failed
  attempts       Int          @default(0)
  maxAttempts    Int          @default(4)
  availableAt    DateTime     @default(now())
  lockedAt       DateTime?
  heartbeatAt    DateTime?
  lockedBy       String?
  lastError      String?
  completedAt    DateTime?
  project        VideoProject @relation(fields: [videoProjectId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([status, availableAt, createdAt])
  @@index([status, heartbeatAt])
  @@index([lockedBy])
}

model FootageAsset {
  id                  String   @id @default(uuid(7))
  userId              String
  title               String
  description         String?
  sourceName          String
  sourceUrl           String
  assetUrl            String
  licenseType         String   @default("unknown")
  commercialUse       Boolean  @default(false)
  modificationAllowed Boolean  @default(false)
  attributionRequired Boolean  @default(false)
  attributionText     String?
  rightsEvidenceUrl   String?
  rightsEvidenceNotes String?
  reviewStatus        String   @default("pending")
  reviewNotes         String?
  reviewedById        String?
  reviewedAt          DateTime?
  expiresAt           DateTime?
  durationSec         Int?
  tags                String   @default("[]")
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([userId, reviewStatus, createdAt])
  @@index([reviewStatus, updatedAt])
  @@index([licenseType])
  @@index([expiresAt])
}

model ThumbnailVariant {
  id             String       @id @default(uuid(7))
  userId         String
  videoProjectId String
  prompt         String
  aspect         String       @default("16:9")
  imagePath      String? // legacy local path; cleared after migration
  objectKey      String?
  provider       String       @default("z-ai")
  model          String?
  isSelected     Boolean      @default(false)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  videoProject   VideoProject @relation(fields: [videoProjectId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([userId, videoProjectId, createdAt])
  @@index([videoProjectId, isSelected])
}


model MediaAsset {
  id             String        @id @default(uuid(7))
  userId         String?
  videoProjectId String?
  kind           String // final_video | scene_thumbnail | thumbnail_variant | uploaded_footage
  objectKey      String        @unique
  mimeType       String
  sizeBytes      BigInt
  sha256         String
  originalName   String
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  videoProject   VideoProject? @relation(fields: [videoProjectId], references: [id], onDelete: Cascade)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([userId, createdAt])
  @@index([videoProjectId, kind])
  @@index([kind, createdAt])
}


// Creator-defined niche, audience, publishing cadence and manually verified YPP data.
model YoutubeNicheProfile {
  id                         String         @id @default(uuid(7))
  channelId                  String         @unique
  niche                      String         @default("")
  subNiche                   String?
  primaryMarket              String         @default("ID")
  secondaryMarkets           String         @default("[]")
  audiencePersona            String?
  audienceProblems           String         @default("[]")
  channelPositioning         String?
  contentPillars             String         @default("[]")
  languages                  String         @default("[\"id\"]")
  weeklyShorts               Int            @default(3)
  weeklyLongVideos           Int            @default(1)
  shortStrategy              String?
  longFormStrategy           String?
  targetShortDurationSec     Int            @default(45)
  targetLongDurationMin      Int            @default(8)
  defaultHook                String?
  outlineTemplate             String?
  callToAction               String?
  yppValidPublicWatchHours   Float?
  yppRequiredPublicWatchHours Float?
  yppValidShortsViews        BigInt?
  yppRequiredShortsViews     BigInt?
  yppManualCheckedAt         DateTime?
  profileVersion             Int            @default(1)
  channel                    YoutubeChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  createdAt                  DateTime       @default(now())
  updatedAt                  DateTime       @updatedAt

  @@index([primaryMarket])
  @@index([updatedAt])
}

// Immutable strategy context captured at the time a content idea is created.
model YoutubeContentStrategySnapshot {
  id              String         @id @default(uuid(7))
  channelId       String
  contentIdeaId   String
  profileVersion  Int
  payload         String
  channel         YoutubeChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  contentIdea     ContentIdea    @relation(fields: [contentIdeaId], references: [id], onDelete: Cascade)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([channelId, createdAt])
  @@index([contentIdeaId])
  @@index([profileVersion])
}

// Private per-video observations from YouTube Analytics reports.
model YoutubeVideoPerformanceSnapshot {
  id                      String         @id @default(uuid(7))
  channelId               String
  videoId                 String
  videoTitle              String         @default("")
  capturedOn              DateTime
  views                   BigInt         @default(0)
  estimatedMinutesWatched Float          @default(0)
  averageViewDuration     Float          @default(0)
  averageViewPercentage   Float          @default(0)
  impressions             Float?
  impressionsCtr          Float?
  estimatedRevenue        Float?
  estimatedAdRevenue      Float?
  currencyCode            String         @default("IDR")
  source                  String         @default("youtube-analytics-api")
  channel                 YoutubeChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt

  @@unique([channelId, videoId, capturedOn])
  @@index([channelId, capturedOn])
  @@index([channelId, views])
  @@index([videoId, capturedOn])
}

// Private country-level observations. These are not public market estimates.
model YoutubeCountryPerformanceSnapshot {
  id                      String         @id @default(uuid(7))
  channelId               String
  countryCode             String
  capturedOn              DateTime
  views                   BigInt         @default(0)
  estimatedMinutesWatched Float          @default(0)
  estimatedRevenue        Float?
  estimatedAdRevenue      Float?
  currencyCode            String         @default("IDR")
  source                  String         @default("youtube-analytics-api")
  channel                 YoutubeChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt

  @@unique([channelId, countryCode, capturedOn])
  @@index([channelId, capturedOn])
  @@index([countryCode, capturedOn])
}

// Saved what-if projection. It must never be presented as actual earnings.
model YoutubeRevenueForecast {
  id                   String         @id @default(uuid(7))
  channelId            String
  targetRevenue        Float
  currencyCode         String         @default("IDR")
  assumedRpm           Float
  baselineDailyViews   Float
  projectionDays       Int
  projectedViews       Float
  lowerForecast        Float
  upperForecast        Float
  requiredViews        Float
  rpmSource            String         @default("manual-assumption") // actual-channel-rpm | manual-assumption
  assumptions          String         @default("{}")
  channel              YoutubeChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  @@index([channelId, createdAt])
  @@index([createdAt])
}
